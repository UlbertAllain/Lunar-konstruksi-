+  "faq",
+  "cta",
+] as const;
+
+export type CmsBlockType = (typeof CMS_BLOCK_TYPES)[number];
+
+export interface CmsBlock {
+  id: string;
+  type: CmsBlockType;
+  variant: string;
+  isVisible: boolean;
+  order: number;
+  content: Record<string, unknown>;
+}
+
+export interface CmsBlockDefinition {
+  type: CmsBlockType;
+  label: string;
+  description: string;
+  defaultVariant: string;
+  variants: readonly string[];
+}
