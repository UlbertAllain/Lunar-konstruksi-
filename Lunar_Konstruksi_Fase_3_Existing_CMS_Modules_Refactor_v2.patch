+      providedSource !== undefined &&
+      providedSource !== expectedSource
+    ) {
+      context.addIssue({
+        code: "custom",
+        path: ["content", "source"],
+        message: `Section ${block.type} hanya boleh menggunakan source ${expectedSource}.`,
